# Target-specific overrides for ESP32 classic (ESP-WROOM32, 4MB flash, NO PSRAM)
# Merged ON TOP OF sdkconfig.defaults when building with:
#   idf.py -B build_esp32_st7789_diy -DFLIPPER_BOARD=esp32_st7789_diy build
# WARNING: WROOM32 has ~520KB SRAM and no PSRAM. Heavy apps will OOM.
# Use this only for bring-up; prefer WROVER (PSRAM) for real use.

# Flash: WROOM32 has 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Single-app partition table for 4MB flash (no OTA — no room). See partitions_singleapp_4mb.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_singleapp_4mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_singleapp_4mb.csv"

# ESP32 classic is dual-core LX6 — keep unicore for Furi compatibility
CONFIG_FREERTOS_UNICORE=y

# BLE: legacy 4.2 advertising (same as S3 boards)
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set

# NO PSRAM on WROOM32 — explicitly disable so a stale S3 sdkconfig can't leak in
# CONFIG_SPIRAM is not set
# CONFIG_SPIRAM_USE_MALLOC is not set
# CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY is not set
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS is not set
# CONFIG_SPIRAM_RODATA is not set
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set

# Classic ESP32 has no native USB-OTG — TinyUSB composite is stubbed
# (furi_hal_usb_hid_stub.c). Do not enable TinyUSB options here.

# WROOM32 has 320KB DRAM / 128KB IRAM usable — the default -Og debug build
# does not fit (IRAM +19KB / DRAM +56KB over). Optimize for size.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Silence (keep) runtime assertions: saves flash, keeps checks cheap
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# IRAM is 4KB+ over budget: move FreeRTOS + Ringbuf code to flash (small
# perf cost, big IRAM win) and keep WiFi out of IRAM.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# NFC needs 3DES (felica, mf_ultralight)
CONFIG_MBEDTLS_DES_C=y

# WiFi: shrink the driver buffers. WROOM32 has no PSRAM, so every byte of
# DMA-capable internal RAM the WiFi driver reserves is a byte the GUI and the
# apps cannot use. IDF defaults (static_rx=10, dyn_rx/tx=32) are tuned for
# throughput; scanning/sniffing/deauth work fine with these, and it frees
# ~10-15KB. Same reduction the no-PSRAM C6-LCD-1.47 board uses.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4

# No OTA on 4MB single-app layout
# CONFIG_OTA_UPDATER is not set
